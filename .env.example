# --- core ---
APP_ENV=local
DB_DSN=pgsql:host=db;port=5432;dbname=gamestore
DB_USER=gamestore
DB_PASSWORD=gamestore

# --- supplier gateway ---
SUPPLIER_A_URL=http://supplier-a:8080
SUPPLIER_B_URL=http://supplier-b:8080
# hard timeout of a single /issue call, seconds
SUPPLIER_TIMEOUT=2
# attempts per supplier before we move on (or give up while state is UNKNOWN)
SUPPLIER_MAX_ATTEMPTS=3
SUPPLIER_BACKOFF_BASE_MS=200
SUPPLIER_BACKOFF_JITTER_MS=150

# --- worker ---
WORKER_POLL_MS=200
WORKER_ID=worker-1
STUCK_ORDER_SECONDS=20
